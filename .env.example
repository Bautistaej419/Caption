# Public frontend configuration only. Do not put LiveKit API secrets here.
# For GitHub Pages, set this as the repository Actions variable
# CAPTION_TOKEN_ENDPOINT. It is public and contains no secret.
CAPTION_TOKEN_ENDPOINT=https://caption-livekit-token.<your-subdomain>.workers.dev/token

# Backend-only values. Put these in Cloudflare Worker secrets, not in this file
# once deployed. They are shown here only as variable names.
LIVEKIT_URL=wss://<your-livekit-project>.livekit.cloud
LIVEKIT_API_KEY=<your-livekit-api-key>
LIVEKIT_API_SECRET=<your-livekit-api-secret>
ALLOWED_ORIGINS=https://<github-user>.github.io,http://localhost:5500
